# ESP32 IoT-Based Two-Wheeler EV Prototype Environment Configuration

# Telemetry Source Mode: 'MOCK' | 'WEBSOCKET' | 'SUPABASE'
VITE_DATA_SOURCE=MOCK

# Simulation Sampling Interval in Milliseconds
VITE_DEFAULT_SAMPLING_MS=1000

# Phase 2 ESP32 WebSocket Endpoint (Optional when running ESP32 WebSocket Server)
# VITE_ESP32_WS_URL=ws://192.168.4.1:81/ws

# Phase 2 Supabase Configuration (Optional for cloud real-time ingestion)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
